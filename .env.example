# AmpliRail environment template. Non-secret settings only.
# Local: cp .env.example .env && php artisan key:generate && php artisan amplirail:secrets:local
# Dev/prod: these are set in the ECS task definition or server environment; SECRETS come from AWS Secrets Manager
# (SECRETS_DRIVER=aws). Never commit a real .env file. Never put provider keys in this file.

APP_NAME=AmpliRail
APP_ENV=local                      # local | development | staging | production
APP_KEY=                           # php artisan key:generate (prod: inject from Secrets Manager)
APP_DEBUG=true                     # MUST be false outside local
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
AMPLIRAIL_ENVIRONMENT_BADGE=sandbox # sandbox | live (badge shown on every portal page)
AMPLIRAIL_DEFAULT_TENANT=org_edatapay

# Public URLs (dev: one host; prod: admin./app./api./pay.amplirail.com)
ADMIN_URL=http://localhost:8000
MERCHANT_URL=http://localhost:8000
PAY_URL=http://localhost:8000
# Optional host pinning (leave empty on a single dev host)
ADMIN_HOST=
MERCHANT_HOST=
API_HOST=
PAY_HOST=
TRUSTED_PROXIES=127.0.0.1          # prod: the load balancer CIDR, e.g. 10.0.0.0/16

# Legal links in every footer. The built-in pages live at /terms, /privacy and /security (resources/views/legal);
# set a full URL only to point at an external copy instead.
LEGAL_TERMS_URL=/terms
LEGAL_PRIVACY_URL=/privacy
LEGAL_SECURITY_URL=/security
LEGAL_STATUS_URL=#[Status]

LOG_CHANNEL=stack
LOG_STACK=single                   # prod: stderr (with LOG_STDERR_FORMATTER below)
LOG_LEVEL=debug                    # prod: info
# LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# Database: PostgreSQL 16. Runtime uses the least-privilege role; migrations use the owner role.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=amplirail
DB_USERNAME=amplirail_app          # runtime role (RLS applies; no UPDATE/DELETE on ledger/audit)
# DB_APP_ROLE=                     # role that receives grants at migration time; defaults to DB_USERNAME
DB_PASSWORD=                       # prod: from Secrets Manager (rotated)
DB_SSLMODE=prefer                  # prod: require
DB_MIGRATION_CONNECTION=pgsql_owner
DB_OWNER_USERNAME=amplirail        # owner role: migrations and partition maintenance only
DB_OWNER_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false        # true outside local (HTTPS)
SESSION_SAME_SITE=strict
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

OUTBOX_PUBLISHER=log               # log | redis_streams | null
OUTBOX_STREAM=amplirail:events

# Secrets (aws in dev/prod; env only for local and CI)
SECRETS_DRIVER=env                 # env | aws
SECRETS_PREFIX=amplirail/local     # amplirail/dev | amplirail/prod
AWS_DEFAULT_REGION=us-east-1
# Local-only values written by: php artisan amplirail:secrets:local
# AMPLIRAIL_SECRET_FIELD_ENCRYPTION_KEY=
# AMPLIRAIL_SECRET_FINGERPRINT_KEY=
# AMPLIRAIL_SECRET_LINK_SIGNING_KEY=

# KYB documents: "documents" (local private disk) or "documents_s3" (private bucket, SSE-KMS)
DOCUMENTS_DISK=documents
DOCUMENTS_BUCKET=
DOCUMENTS_KMS_KEY_ID=

# Feature flags (defaults; runtime changes are made in the admin console and audited). All fail closed.
FEATURE_CRM_HANDOFF=false          # on for the pilot once the CRM client exists
FEATURE_DOCUMENT_CHECKLIST=true
FEATURE_ELIGIBILITY_ENGINE=true
FEATURE_GO_LIVE_GATE=true          # off = nobody can activate a merchant (no bypass)

# Connectors (credentials are per-MID secrets-manager references recorded in the admin console)
CONNECTOR_NMI_ENABLED=false
NMI_TRANSACT_URL=                  # from docs/providers/nmi/ once NMI access is confirmed
NMI_COLLECT_JS_URL=                # hosted fields script (pay page CSP allows only this origin)
NMI_PUBLIC_TOKENIZATION_KEY=       # public browser key, not the security key
CONNECTOR_GATTERA_ENABLED=false    # blocked until Gattera documentation and hosted fields are confirmed
GATTERA_BASE_URL=

WEBHOOKS_ALLOW_INSECURE_TARGETS=false  # true only for local testing against http://localhost
REFUND_STEP_UP_THRESHOLD_MINOR=50000
MERCHANT_IDLE_MINUTES=30

MAIL_MAILER=log                    # prod: ses (credentials from the task role)
MAIL_FROM_ADDRESS="no-reply@amplirail.com"
MAIL_FROM_NAME="AmpliRail"

# Octane (API containers)
OCTANE_SERVER=swoole
