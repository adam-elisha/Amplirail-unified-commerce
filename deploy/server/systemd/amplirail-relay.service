# AmpliRail outbox relay: publishes committed events and fans out webhooks. Restarts fresh every hour.
[Unit]
Description=AmpliRail outbox relay
After=network.target postgresql-17.service

[Service]
User=__USER__
WorkingDirectory=__APP__
ExecStart=__PHP__ __APP__/artisan amplirail:outbox:relay --max-seconds=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
