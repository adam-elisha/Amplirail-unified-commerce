# Non-secret settings. Copy to deploy/.env.local for local work (never commit .env.local).
# In dev and prod these are set in the ECS task definition; secrets come from AWS Secrets Manager.
APP_NAME=AmpliRail
APP_ENV=local            # local | development | production
APP_URL=http://localhost:8000
ADMIN_HOST=localhost      # dev: dev.amplirail.com (/admin)  prod: admin.amplirail.com
MERCHANT_HOST=localhost   # dev: dev.amplirail.com (/app)    prod: app.amplirail.com
API_HOST=localhost        # dev: dev.amplirail.com (/api)    prod: api.amplirail.com
PAY_HOST=localhost        # dev: dev.amplirail.com (/pay)    prod: pay.amplirail.com
DB_CONNECTION=pgsql
DB_HOST=db
DB_DATABASE=amplirail
REDIS_HOST=redis
QUEUE_CONNECTION=redis
CONNECTOR_DEFAULT=simulator     # only "simulator" allowed in local and development unless a sandbox MID is configured
SECRETS_PREFIX=amplirail/local  # amplirail/dev or amplirail/prod
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
