{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "amplipay/amplirail-unified-commerce",
    "type": "project",
    "description": "AmpliRail 2.0: processor-neutral payments orchestration (launch slice + Sprint 0.5 activation engine). Property of AmpliPay Group Inc.",
    "license": "proprietary",
    "repositories": [
        { "type": "path", "url": "packages/amplirail-core", "options": { "symlink": false } }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "amplipay/amplirail-core": "*@dev",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.20",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.0",
        "predis/predis": "^2.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.6",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "files": ["app/helpers.php"],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Connectors\\": "connectors/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php packages/amplirail-core/tests/run.php",
            "@php artisan test"
        ],
        "test:pgsql": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest --configuration=phpunit.pgsql.xml"
        ],
        "core": "@php packages/amplirail-core/tests/run.php",
        "stan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "arch": "@php vendor/bin/pest --group=architecture",
        "contract": "@php vendor/bin/pest --group=contract",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
